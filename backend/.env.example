# =============================================================================
# d3jusdevspace Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# DATABASE_URL is the only required value — the app boots and serves the
# public site with just that. Every other block below degrades gracefully:
# unset Cloudinary and image uploads return 503, unset NEXTAUTH_SECRET and
# the admin API stays closed, unset GROQ_API_KEY and the agent never runs.
# =============================================================================

# --- Database (Neon) --- REQUIRED
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# --- Auth --- optional (unset = admin API returns 401 for everyone)
# Must match the NEXTAUTH_SECRET used in the frontend.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# The owner row seed_owner.py creates, and the email the admin JWT must carry
# to resolve to it. Must match ADMIN_EMAIL in the frontend env.
ADMIN_EMAIL=admin@d3jusdevspace.com

# --- Local Postgres in Docker (development only) ---
# Off by default: with DATABASE_URL pointing at a hosted database, nothing
# should be starting containers. Set true and `scripts/dev_db.sh` will start
# the local pgvector container, creating it on first run. The image must be a
# pgvector one — the schema has Vector(384) columns.
LOCAL_POSTGRES_DOCKER_FOR_DEV=false
# Optional overrides; the defaults match docs/local-development.md.
# DEV_DB_CONTAINER=my-blog-pg
# DEV_DB_IMAGE=pgvector/pgvector:pg16
# DEV_DB_PORT=5432

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Cloudinary (image uploads) --- optional (unset = uploads return 503)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- HuggingFace (free embedding API) ---
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your-token-here

# --- Groq (Agent LLM) --- optional (unset = agent pipeline never runs)
GROQ_API_KEY=gsk_your-groq-api-key-here
# Model for the pipeline (and the chat, unless ASSISTANT_MODEL is set).
# The code default, llama-3.3-70b-versatile, has been retired by Groq and now
# fails with model_not_found — set this. List what your key can use with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# Master switch for the agent, independent of the key above.
AGENT_ENABLED=true

# --- Assistant (public chat) --- optional, off by default
# Needs GROQ_API_KEY too. The widget needs NEXT_PUBLIC_ASSISTANT_ENABLED.
# ASSISTANT_ENABLED=true
# ASSISTANT_NAME=Assistant
# ASSISTANT_PERSONA=a friendly, concise guide to this blog and its posts
# Smaller model for chat; empty = GROQ_MODEL. Chat is billed per reader message.
# ASSISTANT_MODEL=openai/gpt-oss-20b
# Sent with no model call when a question is one only the author can answer
# (hiring, rates, availability, contact). Empty = "see the footer links".
# ASSISTANT_CONTACT=You can reach me on GitHub (https://github.com/you).
# Names readers might use for the author, comma-separated.
# ASSISTANT_AUTHOR_NAMES=
# What the assistant should know beyond posts and series (which it reads from
# the database): pages the backend can't see, like notes or a lab, and who the
# author is. One line; write 
 for a line break. Capped at 4000 characters.
# ASSISTANT_SITE_GUIDE=The Notes (/notes) are ...
The Lab (/lab) is ...
# Spend guards: per caller (best-effort) and in total (the real ceiling).
# ASSISTANT_HOURLY_LIMIT_PER_IP=30
# ASSISTANT_HOURLY_LIMIT_TOTAL=600

# --- Site index (what the assistant searches) ---
# The public site's address. When set, Admin → Knowledge → Rebuild crawls it
# (home page onward, following its own links) so static pages — notes, a lab —
# are searchable as well as posts. Empty = posts only.
# SITE_URL=https://example.com

# --- Tavily (Web Search) ---
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# --- LangFuse (Observability) ---
# Sign up at https://cloud.langfuse.com to get your keys.
# Leave blank to run without tracing (no-op mode).
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com
